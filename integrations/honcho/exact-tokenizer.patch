+def _write_word_level_tokenizer(path: str) -> None:
+    from tokenizers import Tokenizer, models, pre_tokenizers, processors
+
+    tokenizer = Tokenizer(
+        models.WordLevel(
+            vocab={
+                "[UNK]": 0,
+                "search_document": 1,
+                ":": 2,
+                "слово": 3,
+                "[EOS]": 4,
+            },
+            unk_token="[UNK]",
+        )
+    )
+    tokenizer.pre_tokenizer = pre_tokenizers.Whitespace()
+    tokenizer.post_processor = processors.TemplateProcessing(
+        single="$A [EOS]",
+        special_tokens=[("[EOS]", 4)],
+    )
+    tokenizer.save(path)
+
+
+def test_exact_tokenizer_chunks_with_provider_prefix(
+    monkeypatch: pytest.MonkeyPatch,
+    tmp_path: Any,
+) -> None:
+    fake_embeddings = FakeOpenAIEmbeddingsAPI([0.1] * 4)
+
+    class FakeOpenAIClient:
+        def __init__(self, *, api_key: str | None, base_url: str | None) -> None:
+            self.embeddings = fake_embeddings
+
+    monkeypatch.setattr("openai.AsyncOpenAI", FakeOpenAIClient)
+    tokenizer_path = str(tmp_path / "tokenizer.json")
+    _write_word_level_tokenizer(tokenizer_path)
+    exact_tokenizer = _HuggingFaceEmbeddingTokenizer(
+        tokenizer_path,
+        input_prefix="search_document: ",
+        overlap_ratio=0.2,
+    )
+    client = _EmbeddingClient(
+        EmbeddingModelConfig(
+            transport="openai",
+            model="frida",
+            api_key="test-key",
+            base_url="http://localhost:8001/v1",
+        ),
+        vector_dimensions=4,
+        max_input_tokens=5,
+        max_tokens_per_request=1000,
+        send_dimensions=False,
+        embedding_tokenizer=exact_tokenizer,
+    )
+
+    original = "слово слово слово слово слово слово слово"
+    result = client.prepare_chunks({"message": original})["message"]
+
+    assert len(result) > 1
+    assert result[0].startswith("слово")
+    assert result[-1].endswith("слово")
+    assert all(exact_tokenizer.count(chunk) <= 5 for chunk in result)
+
+
+def test_exact_tokenizer_disables_serialized_limits_and_preserves_whitespace(
+    tmp_path: Any,
+) -> None:
+    from tokenizers import Tokenizer
+
+    tokenizer_path = str(tmp_path / "tokenizer.json")
+    _write_word_level_tokenizer(tokenizer_path)
+    serialized = Tokenizer.from_file(tokenizer_path)
+    serialized.enable_truncation(max_length=1)
+    serialized.enable_padding(length=8, pad_id=0, pad_token="[UNK]")
+    serialized.save(tokenizer_path)
+
+    exact_tokenizer = _HuggingFaceEmbeddingTokenizer(
+        tokenizer_path,
+        input_prefix="search_document: ",
+        overlap_ratio=0,
+    )
+    original = "  слово  слово  слово  слово  "
+    chunks = exact_tokenizer.chunk(original, max_tokens=5)
+
+    assert exact_tokenizer.count(original) > 1
+    assert "".join(chunk for chunk, _ in chunks) == original
+    assert all(count <= 5 for _, count in chunks)
+
+
+def test_embedding_client_exposes_configured_exact_tokenizer(
