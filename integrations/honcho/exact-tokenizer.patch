+class _HuggingFaceEmbeddingTokenizer:
+    """Exact provider tokenizer for token accounting and source-preserving chunks."""
+
+    def __init__(
+        self,
+        tokenizer_path: str,
+        *,
+        input_prefix: str = "",
+        overlap_ratio: float = 0.2,
+    ) -> None:
+        if not 0 <= overlap_ratio < 1:
+            raise ValueError("overlap_ratio must be in [0, 1)")
+        self._tokenizer: Tokenizer = Tokenizer.from_file(tokenizer_path)
+        self._tokenizer.no_truncation()
+        self._tokenizer.no_padding()
+        self._input_prefix: str = input_prefix
+        self._overlap_ratio: float = overlap_ratio
+
+    def encode(self, text: str) -> list[int]:
+        return self._tokenizer.encode(text, add_special_tokens=False).ids
+
+    def decode(self, tokens: list[int]) -> str:
+        return self._tokenizer.decode(tokens, skip_special_tokens=True)
+
+    def count(self, text: str) -> int:
+        return len(self._tokenizer.encode(self._input_prefix + text).ids)
+
+    def chunk(self, text: str, max_tokens: int) -> list[tuple[str, int]]:
+        total = self.count(text)
+        if total <= max_tokens:
+            return [(text, total)]
+
+        offsets = self._tokenizer.encode(text, add_special_tokens=False).offsets
+        if not offsets:
+            raise ValueError("Text exceeds token limit but has no content token offsets")
+
+        overlap_tokens = int(max_tokens * self._overlap_ratio)
+        chunks: list[tuple[str, int]] = []
+        start = 0
+        while start < len(offsets):
+            end = min(len(offsets), start + max_tokens)
+            chunk_text = ""
+            chunk_count = max_tokens + 1
+            while end > start:
+                char_start = 0 if start == 0 else offsets[start][0]
+                char_end = len(text) if end == len(offsets) else offsets[end][0]
+                chunk_text = text[char_start:char_end]
+                chunk_count = self.count(chunk_text)
+                if chunk_count <= max_tokens:
+                    break
+                end -= 1
+            if end <= start or not chunk_text:
+                raise ValueError(
+                    "Unable to create a non-empty chunk within the provider token limit"
+                )
+            chunks.append((chunk_text, chunk_count))
+            if end == len(offsets):
+                break
+            start = max(
+                start + 1,
+                end - min(overlap_tokens, end - start - 1),
+            )
+        return chunks
+
