+"""Plugin-local automatic-capture boundary (no host-private imports).
+
+Only typed provenance establishes machine origin. Human text is never classified
+by marker words. Missing transcripts support legacy callers; supplied empty or
+unmatched transcripts are authoritative. This is not a semantic truth filter.
+"""
+from collections.abc import Mapping
+import json
+import re
+from typing import NamedTuple
+
+_TEXT_TYPES = frozenset({'text', 'input_text', 'output_text'})
+_REASON_TYPES = frozenset({'reasoning', 'thinking', 'redacted_thinking', 'analysis', 'reasoning_content', 'summary_text'})
+_HUMAN = frozenset({'', 'human', 'user', 'user_turn', 'human_statement'})
+_ASSISTANT = frozenset({'', 'assistant', 'assistant_turn'})
+_DISPLAY = frozenset({'', 'steer', 'skill_invocation'})
+_REASON_OPEN = re.compile(r'^ {0,3}<(think|thinking|analysis|reasoning)\b[^>]*>', re.I)
+
+
+class _CaptureSlice(NamedTuple):
+    """Logical assistant text and exact slice; revalidated, never a skip flag."""
+    text: str
+    start: int
+    end: int
+
+
+def _without_reasoning_envelopes(content):
+    """Strip raw line-boundary envelopes, not literal Markdown/code examples.
+
+    Re-scan every closing-tag suffix: adjacent envelopes share a boundary.
+    Untyped prose is not classified by keywords or by inline tag resemblance.
+    """
+    result, fence, hidden, ticks = [], None, None, None
+    for line in content.splitlines(keepends=True):
+        while line:
+            if hidden:
+                close = re.search(r'</' + hidden + r'\s*>', line, re.I)
+                if not close:
+                    break
+                line, hidden = line[close.end():], None
+                continue
+            marker = re.match(r'^ {0,3}(`{3,}|~{3,})', line) if ticks is None else None
+            if marker:
+                value = marker.group(1)
+                if fence is None:
+                    fence = value
+                elif (value[0] == fence[0] and len(value) >= len(fence)
+                      and not line[marker.end():].strip()):
+                    fence = None
+                result.append(line)
+                break
+            opening = _REASON_OPEN.match(line) if fence is None and ticks is None else None
+            if opening:
+                hidden = opening.group(1).lower()
+                line = line[opening.end():]
+                continue
+            if fence is None:
+                for tick in re.finditer(r'(?<!\\)`+', line):
+                    width = len(tick.group())
+                    if ticks is None:
+                        ticks = width
+                    elif width == ticks:
+                        ticks = None
+            result.append(line)
+            break
+    return ''.join(result)
+
+
+def visible_text(content, *, assistant=False):
+    if isinstance(content, str):
+        text = content
+    elif isinstance(content, (list, tuple)):
+        text = ''.join(part['text'] for part in content
+                         if isinstance(part, Mapping) and part.get('type') in _TEXT_TYPES
+                         and part.get('channel') in (None, '', 'final')
+                         and allowed_origin(part, 'assistant' if assistant else 'user')
+                         and isinstance(part.get('text'), str))
+    else:
+        return ''
+    return _without_reasoning_envelopes(text) if assistant else text
+
+
+def allowed_origin(message, role):
+    kinds = _HUMAN if role == 'user' else _ASSISTANT
+    for container in (message, message.get('metadata'), message.get('display_metadata')):
+        if not isinstance(container, Mapping):
+            continue
+        if container.get('source_kind', '') not in kinds:
+            return False
+        if container.get('channel') not in (None, '', 'final'):
+            return False
+        if container.get('message_kind') not in (None, '', 'chat', 'text'):
+            return False
+        if container.get('display_kind', '') not in (_DISPLAY if role == 'user' else {''}):
+            return False
+        if container.get('source') in {'runtime_notification', 'machine', 'service', 'reasoning', 'tool_transport'}:
+            return False
+        if container.get('_compressed_summary') or container.get('compaction_inflight_task_restatement'):
+            return False
+    return True
+
+
+def user_text(message):
+    metadata = message.get('display_metadata')
+    typed = metadata.get('typed_ask') if isinstance(metadata, Mapping) else None
+    return typed if isinstance(typed, str) else visible_text(message.get('content'))
+
+
+def safe_message(message):
+    if not isinstance(message, Mapping):
+        return None
+    role = message.get('role')
+    if role not in {'user', 'assistant'} or not allowed_origin(message, role):
+        return None
+    if role == 'assistant' and message.get('tool_calls'):
+        return None
+    proof = message.get('_capture_slice')
+    verified_slice = False
+    if role == 'assistant' and isinstance(proof, _CaptureSlice):
+        # Parse the complete logical message again, retaining fence/code-span
+        # context. Only an exact slice of that safe projection may use it.
+        whole = visible_text(proof.text, assistant=True)
+        verified_slice = (0 <= proof.start < proof.end <= len(whole)
+                          and message.get('content') == whole[proof.start:proof.end])
+    text = (message['content'] if verified_slice else user_text(message) if role == 'user'
+            else visible_text(message.get('content'), assistant=True))
+    if not text.strip():
+        return None
+    row = {'role': role, 'content': text}
+    if verified_slice:
+        row['_capture_slice'] = proof
+    # Internal routing/state only; never copy arbitrary caller metadata or config.
+    for key in ('_capture_final', '_capture_index'):
+        if key in message:
+            row[key] = message[key]
+    if isinstance(message.get('author_peer_id'), str):
+        row['author_peer_id'] = message['author_peer_id']
+    return row
+
+
+def project_messages(messages):
+    """Keep human spans and only their last final assistant, not tool-loop prose."""
+    result, pending = [], []
+    human_turn = False
+    previous_role = None
+    previous_span = False
+    previous_final_chunk = False
+    for message in messages or []:
+        if not isinstance(message, Mapping):
+            continue
+        role = message.get('role')
+        safe = safe_message(message)
+        if role == 'user':
+            span = message.get('capture_current_turn') is True
+            continuation = ((span and previous_span) or message.get('display_kind') == 'steer'
+                            or (previous_role == 'user' and safe is not None and human_turn))
+            if not continuation:
+                result.extend(pending)
+                pending, human_turn = [], False
+            previous_span = span
+            if safe:
+                result.append(safe)
+                human_turn = True
+        elif role == 'assistant':
+            if not (message.get('_capture_final') is True and previous_final_chunk):
+                pending = []
+            previous_span = False
+            if human_turn and safe:
+                pending.append(safe)
+        elif role == 'tool':
+            pending = []
+            previous_span = False
+        previous_role = role
+        previous_final_chunk = role == 'assistant' and message.get('_capture_final') is True
+    result.extend(pending)
+    return result
+
+
+def current_turn(user, assistant, messages):
+    if messages is None:
+        return project_messages([{'role': 'user', 'content': user}, {'role': 'assistant', 'content': assistant}])
+    rows = [message for message in messages if isinstance(message, Mapping)]
+    marked = [i for i, message in enumerate(rows) if message.get('capture_current_turn') is True]
+    if marked:
+        start = marked[0]
+        # A later unmarked user begins another turn, never extend into history.
+        end = next((i for i in range(marked[-1] + 1, len(rows)) if rows[i].get('role') == 'user'), len(rows))
+        return project_messages(rows[start:end])
+    last_user = next((i for i in range(len(rows)-1, -1, -1) if rows[i].get('role') == 'user'), None)
+    if last_user is None:
+        return []
+    start = last_user
+    while start > 0 and rows[start-1].get('role') == 'user':
+        start -= 1
+    # Core projections may contain several detached human spans with no markers.
+    group = rows[start:last_user+1]
+    # The host strips scalar boundary whitespace; it does not rewrite the
+    # authoritative transcript. Match that normalization, export original bytes.
+    expected = user.strip() if isinstance(user, str) else ''
+    if ''.join(user_text(row) for row in group).strip() != expected:
+        if user_text(rows[last_user]).strip() != expected:
+            return []
+        start = last_user
+    return project_messages(rows[start:])
+
+
+def mirror_content(content, metadata=None):
+    metadata = metadata if isinstance(metadata, Mapping) else {}
+    role = 'assistant' if metadata.get('source_kind') in {'assistant', 'assistant_turn'} else 'user'
+    row = safe_message({'role': role, 'content': content, **{key: metadata[key] for key in
+                        ('source_kind', 'source', 'channel', 'display_kind', 'display_metadata', '_compressed_summary') if key in metadata},
+                        'metadata': metadata})
+    if metadata.get('staged') is True or metadata.get('success') is False:
+        return ''
+    return row['content'] if row else ''
+
+
+def import_content(content):
+    """Curated prose is valid; serialized structural payload is not prose.
+
+    Do not guess origin from technical words or embedded human quotes. Standalone
+    reasoning envelopes and JSON message records can be recognized structurally;
+    untyped semantic paraphrases cannot be reliably classified here.
+    """
+    stripped = content.strip()
+    if not stripped:
+        return ''
+    try:
+        value = json.loads(stripped)
+    except (ValueError, TypeError):
+        value = None
+    if isinstance(value, Mapping) and isinstance(value.get('messages'), list):
+        # A native transcript envelope is structural, not a prose JSON example.
+        value = value['messages']
+    if isinstance(value, (dict, list)):
+        records = value if isinstance(value, list) else [value]
+        if any(isinstance(row, Mapping) and ('role' in row or 'source_kind' in row) for row in records):
+            return '\n'.join(row['content'] for row in project_messages(records))
+        if any(isinstance(row, Mapping) and isinstance(row.get('type'), str)
+               and row['type'] in _TEXT_TYPES | _REASON_TYPES for row in records):
+            # Bare typed blocks have no role. Only their visible text is eligible;
+            # thinking/reasoning and sidecar fields must never fall back to JSON.
+            return visible_text(records, assistant=True)
+    return _without_reasoning_envelopes(content)
