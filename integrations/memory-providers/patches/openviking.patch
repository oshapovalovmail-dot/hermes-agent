+    def _startup_profile_identity(self) -> tuple[Path, str]:
+        from hermes_constants import get_hermes_home
+
+        home = Path(self._hermes_home) if self._hermes_home else get_hermes_home()
+        identity = [str(home.resolve()), self._endpoint, self._account,
+                    self._user, self._agent, self._api_key]
+        scope = hashlib.sha256(json.dumps(identity).encode()).hexdigest()
+        return home, f"<!-- openviking-start-profile scope={scope} -->"
+
+    @staticmethod
+    def _saved_startup_profile(home: Path, session_id: str, marker: str) -> bool:
+        """Read the existing API sidecar; never create/migrate a SessionDB.
+
+        Only active user rows with our scoped marker inside a memory fence
+        count. Old unscoped profiles get one compact replacement; inferring a
+        tenant from those old bytes would suppress another user's profile.
+        """
+        if not session_id:
+            return False
+        try:
+            conn = sqlite3.connect((home / "state.db").resolve().as_uri() + "?mode=ro",
+                                   uri=True, timeout=0.1)
+            try:
+                return conn.execute(
+                    "SELECT 1 FROM messages WHERE session_id = ? "
+                    "AND role = 'user' AND active = 1 "
+                    "AND instr(api_content, ?) > instr(api_content, '<memory-context>') "
+                    "AND instr(api_content, '<memory-context>') > 0 "
+                    "AND instr(api_content, ?) < instr(api_content, '</memory-context>') "
+                    "AND instr(COALESCE(content, ''), ?) = 0 LIMIT 1",
+                    (session_id, marker, marker, marker),
+                ).fetchone() is not None
+            finally:
+                conn.close()
+        except (OSError, sqlite3.Error):
+            # Missing/legacy/locked DB must not disable memory or create state.
+            return False
+
+    @staticmethod
+    def _query_tokens(query: str) -> List[str]:
+        # Lexical anchors are conservative corroboration, not a second vector
+        # search. Generic request verbs/stopwords must not certify a topic.
+        stop = set((
+            "the and for with from this that what which should would could please "
+            "user memory context recall install check inspect explain help about "
+            "как что это для или при мне тебя почему пожалуйста установи "
+            "разберись работает другой нужно проверь расскажи "
+            "подбери придумай выбери сравни учти топ приоритет желательно "
+            "если такое возможно возможности качество надежность стандартных "
+            "recommend suggest advise pick shortlist give offer make "
+            "recommendation recommendations suggestion selection prioritize prioritise "
+            "порекомендуй рекомендуй посоветуй предложи выбрать выбирать подобрать сравнить "
+            "выбор рекомендации "
+            # Pronouns, auxiliaries and polite request framing are not topics.
+            "you your yours yourself yourselves our ours ourselves they their theirs them "
+            "he him his himself her hers herself its itself was were are been being "
+            "has have had does did doing will shall might must can may not nor but "
+            "these those than then when where why who whom whose whether both either "
+            "neither each all more most less many much just even very really "
+            "like kindly appreciate looking ask asking help "
+            "вам вас ваши ваш вами нас нам наши наш нами меня мной твой твои тебе тобой "
+            "себя себе помоги подскажи хотелось хотел хотела хотим можете можно "
+            # Keep generic framing aligned with the other automatic selector.
+            "also any assistant current how if need only project request show some "
+            "such task tell use used want wants где его задача запрос использовать "
+            "любой мои мой надо найди некоторые она они покажи про проект также "
+            "текущий только хочу "
+            # Continuation commands do not supply a topic or renew permissions.
+            "continue proceed resume finish complete carry done next "
+            "делай доделай доделывай доделать продолжай продолжить продолжи "
+            "заверши закончи закончить "
+            "best top choose compare find select priority quality reliable reliability "
+            "possible possibility capabilities preferably standard"
+        ).split())
+        return automatic_recall_terms(query, stop)
+
+    @classmethod
+    def _recall_has_topic(cls, text: str, query_tokens: List[str]) -> bool:
+        return recall_has_topic(text, query_tokens)
+
+    def _resolve_recall_content(
+        self,
+        client: _VikingClient,
+        item: Dict[str, Any],
+        *,
+        prefer_abstract: bool,
+        deadline: float,
+        request_timeout: float,
+        read_state: Dict[str, int],
+        full_read_limit: int,
+    ) -> str:
+        abstract = self._recall_abstract(item)
+        has_explicit_summary = any(
+            isinstance(item.get(key), str) and item.get(key).strip()
+            for key in ("abstract", "overview", "text", "content")
+        )
+        if prefer_abstract and has_explicit_summary:
+            return abstract
+        uri = str(item.get("uri") or "")
+        if uri and (item.get("level") == 2 or not has_explicit_summary):
+            if read_state["full_reads"] >= full_read_limit:
+                return ""
+            try:
+                timeout = self._remaining_recall_timeout(deadline, request_timeout)
+                read_state["full_reads"] += 1
+                content = self._extract_text_content(
+                    client.get(
+                        "/api/v1/content/read",
+                        params={"uri": uri},
+                        timeout=timeout,
+                    )
+                )
+                if content:
+                    return content
+            except Exception as e:
+                logger.debug("OpenViking prefetch full read failed for %s: %s", uri, e)
+            # An unverified leaf summary must not substitute for its actual body.
+            return ""
+        return abstract
+
+    @staticmethod
+    def _capture_text_sources(message: Dict[str, Any], text: str) -> List[tuple[str, str, str]]:
+        """Keep human text and runtime frames separate, without guessing quote intent.
+
+        Source/scope supplied by canonical callers wins. Legacy transport only
+        has role=user: recognize the exact runtime shapes at unquoted boundaries.
+        Async frames have no closing delimiter, so only standalone frames are
+        provable; embedded/quoted/unclosed text is retained unchanged.
+        """
+        metadata = message.get("metadata")
+        metadata = metadata if isinstance(metadata, dict) else {}
+        kind = message.get("source_kind") or metadata.get("source_kind")
+        if kind:
+            return [(str(kind), str(message.get("scope") or metadata.get("scope") or "session"), text)]
+        if message.get("role") != "user":
+            return [("assistant", "session", text)]
+        # Async formatters have no body terminator. Even a standalone-looking
+        # prefix cannot prove the origin of its tail; only explicit source_kind
+        # above may classify that entire message as machine-owned.
+        spans = []
+        fenced = False
+        offset = 0
+        for line in text.splitlines(keepends=True):
+            if line.lstrip().startswith(("```", "~~~")):
+                fenced = not fenced
+            if not fenced and line.startswith("[IMPORTANT: Background process "):
+                # Colon-introduced blocks can be operator-supplied quotations or
+                # documents. Without structured origin, keep them as supplied.
+                if text[:offset].rstrip().endswith(":"):
+                    offset += len(line)
+                    continue
+                tail = text[offset:]
+                if re.match(r"\[IMPORTANT: Background process [^\n]*\nCommand:[^\n]*\n"
+                            r"(?:Output|Matched output):\n", tail):
+                    depth = 0
+                    for index, ch in enumerate(tail):
+                        depth += (ch == "[") - (ch == "]")
+                        if depth == 0:
+                            end = offset + index + 1
+                            if end == len(text) or text[end] in "\r\n":
+                                spans.append((offset, end))
+                            break
+            offset += len(line)
+        if not spans:
+            return [("user", "session", text)]
+        sources = []
+        start = 0
+        for left, right in spans:
+            if left < start:
+                continue
+            if text[start:left].strip():
+                sources.append(("user", "session", text[start:left].strip()))
+            sources.append(("machine_notification", "task", text[left:right]))
+            start = right
+        if text[start:].strip():
+            sources.append(("user", "session", text[start:].strip()))
+        return sources
+
