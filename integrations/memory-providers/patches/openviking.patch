+        start = 0
+        for left, right in spans:
+            if left < start:
+                continue
+            if text[start:left].strip():
+                sources.append(("user", "session", text[start:left].strip()))
+            sources.append(("machine_notification", "task", text[left:right]))
+            start = right
+        if text[start:].strip():
+            sources.append(("user", "session", text[start:].strip()))
+        return sources
