+        if not path.exists():
+            return None
+        try:
+            data = json.loads(path.read_text(encoding="utf-8"))
+            if data.get("schema_version") != 1 or not isinstance(data.get("retired"), list):
+                raise ValueError("invalid correction registry schema")
+            if data.get("workspace_id") != self.honcho.workspace_id:
+                return None
+            retired = {
+                str(item["id"]) for item in data["retired"]
+                if item.get("observer_id") == observer and item.get("observed_id") == observed
+            }
+            if not retired:
+                return None
+            if not query:
+                return ""
+            scope = self._get_or_create_peer(observer).conclusions_of(observed)
+            rows = scope.query(query[:4000], top_k=12)
