+"""Detached, chunk-safe provider capture inputs."""
+from typing import Any
+from .recall_contracts import HUMAN_DERIVATION_INSTRUCTIONS, is_runtime_notification
+
+def build_capture_turn(user: str, assistant: str, *, messages: list[dict[str, Any]] | None = None, max_chars: int = 25000) -> list[dict[str, Any]]:
+    """Build detached native-message inputs before the provider queues a turn.
+
+    Authoritative current-turn spans come from MemoryManager, not a prefix.
+    Existing unclosed async text remains human-supplied with derivation guards.
+    Chunk by slicing, retaining whitespace and the original source on every part.
+    """
+    sources: list[dict[str, Any]] = [dict(message) for message in (messages or [])
+               if message.get("capture_current_turn")]
+    if not sources:
+        # An explicitly attributed canonical current user message is supported
+        # even when the call did not originate in the gateway span adapter.
+        for message in reversed(messages or []):
+            if message.get("role") == "user":
+                if message.get("content") == user:
+                    sources = [dict(message)]
+                break
+    if not sources:
+        sources = [{"role": "user", "content": user,
+                    "source_kind": "machine_notification" if is_runtime_notification(user) else "human"}]
+    sources.append({"role": "assistant", "content": assistant, "source_kind": "assistant"})
+    from agent.memory_manager import sanitize_context
+
+    rows = []
+    for message in sources:
+        text = message.get("content") or ""
+        if not isinstance(text, str) or not text:
+            continue
+        # Scrub before slicing: fences can span message chunks. Keep clean
+        # provenance spans byte-identical, including their boundary whitespace.
+        cleaned = sanitize_context(text)
+        if cleaned != text:
+            text = cleaned.strip()
+        if not text:
+            continue
+        metadata: dict[str, Any] = dict(message.get("metadata") or {})
+        role = message.get("role", "user")
+        kind = message.get("source_kind") or metadata.get("source_kind") or ("human" if role == "user" else "assistant")
+        machine = kind in {"machine_notification", "machine", "runtime_notification", "task_assignment"}
+        human = role == "user" and kind == "human"
+        metadata.update(source="runtime_notification" if machine else f"{role}_turn",
+                        original_role=role, source_kind=kind,
+                        scope=message.get("scope") or metadata.get("scope") or ("human_statement" if human else "session"))
+        configuration = {"reasoning": {"custom_instructions": HUMAN_DERIVATION_INSTRUCTIONS}} if human else {"reasoning": {"enabled": False}}
+        size = max_chars if max_chars > 0 else len(text)
+        for start in range(0, len(text), size):
+            rows.append({"role": "assistant" if machine else role,
+                         "content": text[start:start + size],
+                         "metadata": dict(metadata), "configuration": configuration})
+    return rows
+
