+                str(row.content) for row in rows
+                if getattr(row, "id", None) is not None and str(row.id) not in retired
+                and getattr(row, "content", None)
+            )
+        except Exception:
+            # Do not let a cached summary resurrect known-invalid assertions.
+            logger.warning("ID-bearing corrected Honcho recall unavailable")
+            return ""
