+    def _retired_conclusion_context(
+        self, observer: str, observed: str, query: str | None,
+    ) -> str | None:
+        """Exclude verified superseded IDs without deleting source history.
+
+        The registry belongs to this Hermes profile and exact Honcho perspective.
+        Cached representations lack IDs: once a perspective has retirements, only
+        an ID-bearing native query may supply its automatic observations. Cards
+        and explicit history access remain available even if that query fails.
+        """
+        from hermes_constants import get_hermes_home
