+"""Conservative, paragraph-atomic automatic recall (explicit discovery is unchanged)."""
+from __future__ import annotations
+
+import re
+
+from agent.recall_query import automatic_recall_terms
+from agent.recall_query import recall_has_topic
+from .recall_contracts import _RECALL_STOPWORDS, complete_units
+
+# Subject-free question framing cannot corroborate an unrelated historical
+# dispute/status. These are query operators, never prohibited output words.
+_AUTOMATIC_STOPWORDS = _RECALL_STOPWORDS | frozenset(
+    "кто кому чем чего какой какая какие сам сама можешь сейчас статус прав неправ "
+    "who whom whose right wrong status now yourself".split()
+)
+
+
+def select_history(text: str, query: str) -> str:
+    """Do not borrow relevance across headings, dated observations or paragraphs."""
+    terms = automatic_recall_terms(query, _AUTOMATIC_STOPWORDS)
+    if not terms:
+        return ""
+    observations = re.split(r"(?m)(?=^\[\d{4}-\d{2}-\d{2})|(?m:^## .*$)", text)
+    return "\n\n".join(
+        unit for observation in observations for unit in complete_units(observation)
+        if all(unit.count(left) == unit.count(right)
+               for left, right in (("(", ")"), ("[", "]"), ("«", "»"), ("“", "”")))
+        and recall_has_topic(re.sub(r"^\[\d{4}-\d{2}-\d{2}[^\]]*\]\s*", "", unit), terms)
+    )
+
+
+def bound_units(text: str, cap: int, *, card: bool = False) -> str:
+    """Never clip a scoped paragraph; report exactly how many units were omitted."""
+    text = text.strip()
+    if len(text) <= cap:
+        return text
+    units = complete_units(text, card=card)
+    separator = "\n" if card else "\n\n"
+    chosen = []
+    # Reserve the largest possible count marker before choosing complete units.
+    marker = f"[Honcho omitted {len(units)} complete unit(s).]"
+    for unit in units:
+        candidate = separator.join(chosen + [unit])
+        if len(candidate) + len(separator) + len(marker) <= cap:
+            chosen.append(unit)
