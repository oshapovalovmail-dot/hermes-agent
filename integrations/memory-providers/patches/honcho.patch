+"""Detached automatic-capture DTOs, scrubbed before chunking or queueing."""
+from copy import deepcopy
+from typing import Any
+from .egress import _CaptureSlice, current_turn, safe_message
+from .recall_contracts import HUMAN_DERIVATION_INSTRUCTIONS
+
+
+def native_row(message, *, legacy=False):
+    """SDK-ready allowlist, also used immediately before serialization."""
+    row = safe_message(message)
+    if row is None:
+        return None
+    role = row['role']
+    human = role == 'user'
+    row['metadata'] = {'source': f'{role}_turn', 'original_role': role,
+                       'source_kind': 'human' if human else 'assistant',
+                       'scope': 'human_statement' if human else 'session'}
+    row['configuration'] = ({'reasoning': {'custom_instructions': HUMAN_DERIVATION_INSTRUCTIONS}}
+                            if human else {'reasoning': {'enabled': False}})
+    if legacy and not message.get('_capture_final') and 'metadata' not in message and 'configuration' not in message:
+        row.pop('metadata')
+        row.pop('configuration')
+    return row
+
+
+def _chunks(text, size):
+    # SDK rejects whitespace-only messages. Attach a whitespace-only slice to
+    # its neighbor without dropping bytes (the cap is soft for whitespace).
+    chunks = [text[i:i+size] for i in range(0, len(text), size)]
+    result, prefix = [], ''
+    for chunk in chunks:
+        if not chunk.strip():
+            if result:
+                result[-1] += chunk
+            else:
+                prefix += chunk
+        else:
+            result.append(prefix + chunk)
+            prefix = ''
+    return result
+
+
+def build_capture_turn(user: str, assistant: str, *, messages: list[dict[str, Any]] | None = None,
+                       max_chars: int = 25000) -> list[dict[str, Any]]:
+    rows = []
+    for message in current_turn(user, assistant, messages):
+        row = native_row(message)
+        if row is None:
+            continue
+        text = row.pop('content')
+        start = 0
+        for chunk in _chunks(text, max_chars if max_chars > 0 else len(text)):
+            captured = {**deepcopy(row), 'content': chunk, '_capture_final': True}
+            if row['role'] == 'assistant':
+                captured['_capture_slice'] = _CaptureSlice(text, start, start + len(chunk))
+            rows.append(captured)
+            start += len(chunk)
+    return rows
