+"""Query/thread generation-fenced automatic recall on the native provider lifecycle."""
+from __future__ import annotations
+import logging
+import time
+from agent.recall_query import is_continuation_prompt
+from .client import spawn_context_thread
+logger = logging.getLogger(__name__)
+
+class AutomaticRecallMixin:
+    def _activate_recall(self, query: str, session_id: str) -> int:
+        """Exact query + real runtime thread identity, with generation fencing.
+
+        Never infer a short follow-up's topic from arbitrary backend history.
+        Returning to an earlier query is a new generation, not permission for an
+        older in-flight request to publish into it.
+        """
+        identity = (self._session_key, session_id, query.strip())
+        with self._recall_lock:
+            if identity != self._recall_identity:
+                self._recall_identity = identity
+                self._recall_generation += 1
+                self._base_context_cache = None
+                self._base_context_data = {}
+                self._last_context_turn = -999
+                self._last_dialectic_turn = -999
+                self._dialectic_empty_streak = 0
+                with self._prefetch_lock:
+                    self._prefetch_result = ""
+                    self._prefetch_result_generation = -1
+            return self._recall_generation
+
+
+    def _start_base_refresh(self, query: str, generation: int) -> threading.Thread | None:
+        with self._recall_lock:
+            # One real request at a time, even after a pivot. Its result is fenced.
+            if self._base_thread and self._base_thread.is_alive():
+                return self._base_thread
+            self._last_context_turn = self._turn_count
+            manager, session_key = self._manager, self._session_key
+
+            def run() -> None:
+                try:
+                    ctx = manager.get_prefetch_context(session_key, query) or {}
+                    with self._recall_lock:
+                        if generation == self._recall_generation:
+                            self._base_context_data = ctx
+                            self._base_context_cache = ""  # fetched, even if empty
+                except Exception as exc:
+                    logger.debug("Honcho automatic base retrieval failed: %s", exc)
+
+            self._base_thread = spawn_context_thread(run, name="honcho-base-query", owner=self)
+            self._base_thread.start()
+            return self._base_thread
+
+
+    def _start_dialectic_refresh(self, query: str, generation: int) -> None:
+        # Do not spawn unbounded replacement workers on repeated pivots.
+        if self._prefetch_thread and self._prefetch_thread.is_alive():
+            return
+        fired_at = self._turn_count
+        owner = (self._manager, self._session_key, generation)
+
+        def run() -> None:
+            try:
+                result = self._run_dialectic_depth(query, _owner=owner)
+            except Exception as exc:
+                logger.debug("Honcho automatic synthesis failed: %s", exc)
+                result = ""
+            with self._recall_lock:
+                if generation != self._recall_generation:
+                    return
+                if result and result.strip():
+                    with self._prefetch_lock:
+                        self._prefetch_result = result
+                        self._prefetch_result_generation = generation
+                        self._prefetch_result_fired_at = fired_at
+                    self._last_dialectic_turn = fired_at
+                    self._dialectic_empty_streak = 0
+                else:
+                    self._dialectic_empty_streak += 1
+
+        self._prefetch_thread_started_at = time.monotonic()
+        self._prefetch_thread = spawn_context_thread(run, name="honcho-prefetch-query", owner=self)
+        self._prefetch_thread.start()
+
+
+    def prefetch(self, query: str, *, session_id: str = "") -> str:
+        """Query-bound automatic evidence; later turns never wait for network I/O."""
+        if self._cron_skipped or self._recall_mode == "tools":
+            return ""
+        generation = self._activate_recall(query, session_id)
+        if is_continuation_prompt(query) or self._is_trivial_prompt(query):
+            return ""
+        if self._recall_sync:
+            from .recall_sync import prefetch_sync
+            return prefetch_sync(self, query)
+        first_turn = self._turn_count <= 1
+        base_wait = self._FIRST_TURN_BASE_TIMEOUT if first_turn else 0.0
+        timeout = getattr(self._config, "timeout", None)
+        if timeout is not None:
+            base_wait = min(base_wait, max(0.0, timeout))
+        deadline = time.monotonic() + base_wait
+        if not self._session_ready():
+            self._start_session_init_background()
+            if first_turn and self._init_thread:
+                self._init_thread.join(timeout=max(0.0, deadline - time.monotonic()))
+            if not self._session_ready():
+                return self._pop_auth_notice() or self._pop_peer_notice()
+        from .automatic_context import bound_units, select_history
+
+        parts = [part for part in [self._pop_auth_notice(), self._pop_peer_notice()] if part]
+        skip_base = self._injection_frequency == "first-turn" and not first_turn
+        if not skip_base:
+            if self._base_context_cache is None:
+                thread = self._start_base_refresh(query, generation)
+                if first_turn and thread:
+                    thread.join(timeout=max(0.0, deadline - time.monotonic()))
+            with self._recall_lock:
+                ctx = dict(self._base_context_data)
+            # Defense in depth: summaries and every historical representation
+            # need query corroboration; standing identity cards do not.
+            for key in ("summary", "representation", "ai_representation"):
+                if isinstance(ctx.get(key), str):
+                    ctx[key] = select_history(ctx[key], query)
+            base = self._format_first_turn_context(ctx)
+            if base:
+                parts.append(base)
+
+        if self._last_dialectic_turn == -999:
+            self._start_dialectic_refresh(query, generation)
+            if first_turn and self._prefetch_thread:
+                wait = self._FIRST_TURN_DIALECTIC_CAP
+                if timeout is not None:
+                    wait = min(wait, max(0.0, timeout))
+                self._prefetch_thread.join(timeout=wait)
+        result = select_history(self._consume_pending_dialectic(), query)
+        if result:
+            header = "## Honcho Historical Synthesis\n"
+            total_cap = (self._config.context_tokens * 4
+                         if self._config and self._config.context_tokens else 7200)
+            remaining = total_cap - len("\n\n".join(parts)) - (2 if parts else 0) - len(header)
+            configured_cap = getattr(self._config, "dialectic_max_chars", 600)
+            cap = min(remaining, configured_cap) if configured_cap else remaining
+            body = bound_units(result, max(0, cap))
+            if body:
+                parts.append(header + body)
+        return "\n\n".join(parts)
+
+
+    def _consume_pending_dialectic(self) -> str:
+        with self._prefetch_lock:
+            result = self._prefetch_result
+            generation = self._prefetch_result_generation
+            fired_at = self._prefetch_result_fired_at
+            self._prefetch_result = ""
+            self._prefetch_result_fired_at = -999
+        if generation != self._recall_generation:
+            return ""
+        if fired_at >= 0 and self._turn_count - fired_at > self._dialectic_cadence * self._STALE_RESULT_MULTIPLIER:
+            return ""
+        return result or ""
+
+
+    def _truncate_to_budget(self, text: str) -> str:
+        from .automatic_context import bound_units
+        cap = self._config.context_tokens * 4 if self._config and self._config.context_tokens else 7200
+        return bound_units(text, cap)
+
+
+    def queue_prefetch(self, query: str, *, session_id: str = "") -> None:
+        """Refresh only this exact request; a different next request discards it."""
+        if self._cron_skipped or self._recall_mode == "tools" or self._recall_sync:
+            return
+        # A delayed end-of-turn callback must not roll back a newer identity.
+        identity = (self._session_key, session_id, query.strip())
+        if self._recall_identity is not None and identity != self._recall_identity:
+            return
+        generation = self._activate_recall(query, session_id)
+        if self._is_trivial_prompt(query) or is_continuation_prompt(query):
+            return
+        if not self._session_ready():
+            self._start_session_init_background()
+            return
+        if (self._injection_frequency != "first-turn"
+                and self._turn_count - self._last_context_turn >= self._context_cadence):
+            self._start_base_refresh(query, generation)
+        if self._turn_count - self._last_dialectic_turn >= self._effective_cadence():
+            self._start_dialectic_refresh(query, generation)
+
