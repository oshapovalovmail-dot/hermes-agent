+    def _seed_once(self, peer: Any, source_key: str, content: str, write: Any,
+                   *, legacy_file: str | None = None) -> bool:
+        """Deduplicate unchanged imports, preserving unrelated peer metadata.
+
+        A write is marked only after success. Old local-memory uploads can be
+        recognized by exact wrapped body; this is a bounded compatibility read,
+        not a backfill or deletion. Metadata failure fails open for real facts.
+        """
+        digest = hashlib.sha256(content.encode("utf-8")).hexdigest()
+        with _SEED_LOCK:
+            metadata: dict = {}
+            try:
+                existing = peer.get_metadata()
+                if isinstance(existing, dict):
+                    metadata = dict(existing)
+            except Exception:
+                logger.debug("Honcho seed metadata unavailable")
+            seeds = dict(metadata.get(_SEED_METADATA_KEY) or {})
+            if seeds.get(source_key) == digest:
+                return False
+            legacy_match = False
+            if legacy_file and source_key not in seeds:
+                try:
+                    previous = self.honcho.search(
+                        content[:300], filters={"peer_id": peer.id, "metadata": {
+                            "source": "local_memory", "original_file": legacy_file,
+                        }}, limit=20,
+                    )
+                    for msg in previous:
+                        body = getattr(msg, "content", "") or ""
+                        match = re.search(r"<prior_memory_file>.*?</context>\s*(.*?)\s*</prior_memory_file>", body, re.DOTALL)
+                        if match and match.group(1).strip() == content:
+                            legacy_match = True
+                            break
+                except Exception:
+                    logger.debug("Honcho legacy seed lookup unavailable")
+            if not legacy_match:
+                write(digest)
+            seeds[source_key] = digest
+            metadata[_SEED_METADATA_KEY] = seeds
+            try:
+                peer.set_metadata(metadata)
+            except Exception:
+                logger.warning("Honcho seed saved but dedup metadata could not be persisted")
+            return not legacy_match
