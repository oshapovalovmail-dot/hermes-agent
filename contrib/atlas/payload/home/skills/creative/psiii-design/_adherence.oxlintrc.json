{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "assets/icons/**",
              "components/brand/**",
              "components/core/**",
              "components/slides/**",
              "components/uikit/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:YS Display Cond|YS Text))/i]",
        "message": "Font not provided by the design system. Available: YS Display Cond, YS Text."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|initials|size|badge|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: src, alt, initials, size, badge."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|dot|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, dot."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:type|size|iconOnly|iconLeft|iconRight|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: type, size, iconOnly, iconLeft, iconRight."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|size|disabled|label|onChange|key|ref|className|style|children)$/]",
        "message": "<Checkbox> doesn't accept that prop. Declared props: checked, size, disabled, label, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='ColorSwatch'] > JSXAttribute > JSXIdentifier[name!=/^(?:color|value|label|w|h|key|ref|className|style|children)$/]",
        "message": "<ColorSwatch> doesn't accept that prop. Declared props: color, value, label, w, h."
      },
      {
        "selector": "JSXOpeningElement[name.name='ContextMenu'] > JSXAttribute > JSXIdentifier[name!=/^(?:width|key|ref|className|style|children)$/]",
        "message": "<ContextMenu> doesn't accept that prop. Declared props: width."
      },
      {
        "selector": "JSXOpeningElement[name.name='Divider'] > JSXAttribute > JSXIdentifier[name!=/^(?:orientation|inset|key|ref|className|style|children)$/]",
        "message": "<Divider> doesn't accept that prop. Declared props: orientation, inset."
      },
      {
        "selector": "JSXOpeningElement[name.name='Divider'] > JSXAttribute[name.name='orientation'] > Literal[value!=/^(?:horizontal|vertical)$/]",
        "message": "<Divider> orientation must be one of 'horizontal' | 'vertical'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|color|bg|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, color, bg."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|iconLeft|size|style|inputStyle|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, iconLeft, size, style, inputStyle."
      },
      {
        "selector": "JSXOpeningElement[name.name='ListItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|iconLeft|hint|trailing|selected|disabled|key|ref|className|style|children)$/]",
        "message": "<ListItem> doesn't accept that prop. Declared props: label, iconLeft, hint, trailing, selected, disabled."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|tone|height|width|key|ref|className|style|children)$/]",
        "message": "<Logo> doesn't accept that prop. Declared props: kind, tone, height, width."
      },
      {
        "selector": "JSXOpeningElement[name.name='Modal'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|title|onClose|actions|width|divider|closeIcon|key|ref|className|style|children)$/]",
        "message": "<Modal> doesn't accept that prop. Declared props: open, title, onClose, actions, width, divider, closeIcon."
      },
      {
        "selector": "JSXOpeningElement[name.name='QuoteBubble'] > JSXAttribute > JSXIdentifier[name!=/^(?:quote|author|role|avatar|quoteSize|radius|tailSize|key|ref|className|style|children)$/]",
        "message": "<QuoteBubble> doesn't accept that prop. Declared props: quote, author, role, avatar, quoteSize, radius, tailSize."
      },
      {
        "selector": "JSXOpeningElement[name.name='RadioButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|size|disabled|label|name|value|onChange|key|ref|className|style|children)$/]",
        "message": "<RadioButton> doesn't accept that prop. Declared props: checked, size, disabled, label, name, value, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='Select'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|placeholder|value|iconLeft|size|style|key|ref|className|style|children)$/]",
        "message": "<Select> doesn't accept that prop. Declared props: label, placeholder, value, iconLeft, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SlideFooter'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|right|key|ref|className|style|children)$/]",
        "message": "<SlideFooter> doesn't accept that prop. Declared props: label, right."
      },
      {
        "selector": "JSXOpeningElement[name.name='SlideFrame'] > JSXAttribute > JSXIdentifier[name!=/^(?:bg|grid|inset|key|ref|className|style|children)$/]",
        "message": "<SlideFrame> doesn't accept that prop. Declared props: bg, grid, inset."
      },
      {
        "selector": "JSXOpeningElement[name.name='SlideHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:left|mark|key|ref|className|style|children)$/]",
        "message": "<SlideHeader> doesn't accept that prop. Declared props: left, mark."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatNumber'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|caption|accent|size|align|key|ref|className|style|children)$/]",
        "message": "<StatNumber> doesn't accept that prop. Declared props: value, caption, accent, size, align."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatNumber'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center)$/]",
        "message": "<StatNumber> align must be one of 'left' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Switcher'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|size|disabled|onChange|key|ref|className|style|children)$/]",
        "message": "<Switcher> doesn't accept that prop. Declared props: checked, size, disabled, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='Switcher'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:normal|small)$/]",
        "message": "<Switcher> size must be one of 'normal' | 'small'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TabItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|icon|key|ref|className|style|children)$/]",
        "message": "<TabItem> doesn't accept that prop. Declared props: id, label, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|iconLeft|removable|pinned|onRemove|radius|key|ref|className|style|children)$/]",
        "message": "<Tag> doesn't accept that prop. Declared props: tone, iconLeft, removable, pinned, onRemove, radius."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextArea'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|required|style|textareaStyle|key|ref|className|style|children)$/]",
        "message": "<TextArea> doesn't accept that prop. Declared props: label, required, style, textareaStyle."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tooltip'] > JSXAttribute > JSXIdentifier[name!=/^(?:arrow|key|ref|className|style|children)$/]",
        "message": "<Tooltip> doesn't accept that prop. Declared props: arrow."
      },
      {
        "selector": "JSXOpeningElement[name.name='Trobber'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|color|key|ref|className|style|children)$/]",
        "message": "<Trobber> doesn't accept that prop. Declared props: size, color."
      }
    ]
  },
